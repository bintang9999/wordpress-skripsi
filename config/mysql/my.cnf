[mysqld]
# ==============================================================================
# MariaDB tuning untuk low-memory ARM64 server
# Target: Xiaomi Redmi Note 4, container mem_limit=384m
# ==============================================================================

# --- Character Set ---
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# --- InnoDB Buffer Pool ---
# Utama penentu penggunaan RAM. Kecilkan untuk server RAM terbatas.
innodb_buffer_pool_size    = 128M
innodb_buffer_pool_instances = 1
innodb_log_file_size       = 32M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method        = O_DIRECT

# --- Koneksi ---
# WordPress biasanya butuh < 10 koneksi bersamaan
max_connections     = 30
thread_cache_size   = 4
wait_timeout        = 300
interactive_timeout = 300

# --- Packet & Temp Tables ---
max_allowed_packet  = 64M
tmp_table_size      = 16M
max_heap_table_size = 16M

# --- Query Cache (dinonaktifkan, deprecated di MariaDB baru) ---
query_cache_type = 0
query_cache_size = 0

# --- Slow Query Log ---
slow_query_log    = 1
long_query_time   = 2

# --- Keamanan & Performa ---
skip_name_resolve = 1
performance_schema = OFF

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

