# ==============================================================================
# .env.example - Template Konfigurasi Portal Kampus
# INSTRUKSI:
#   1. Salin file ini: cp .env.example .env
#   2. JANGAN commit file .env ke Git!
#   3. Ganti SEMUA nilai placeholder di bawah ini
# ==============================================================================

# === DATABASE (MariaDB) ===
# Password root MariaDB - gunakan karakter acak yang kuat
MYSQL_ROOT_PASSWORD=changeme_root_GANTI_INI
# Nama database WordPress
MYSQL_DATABASE=portal_kampus
# User database (bukan root)
MYSQL_USER=wp_user
# Password user database
MYSQL_PASSWORD=changeme_wp_GANTI_INI

# === WORDPRESS DATABASE CONNECTION ===
# Harus sama dengan MYSQL_USER dan MYSQL_PASSWORD di atas
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=changeme_wp_GANTI_INI
WORDPRESS_DB_NAME=portal_kampus

# === WORDPRESS URL ===
# Ganti dengan IP/domain server Anda
WP_HOME=http://192.168.0.108:8083
WP_SITEURL=http://192.168.0.108:8083

# === WP-CLI / SEED SCRIPT ===
# Akun administrator WordPress pertama
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=Admin@Portal2024_GANTI
WP_ADMIN_EMAIL=admin@portal-kampus.local

# Judul situs
WP_TITLE=Portal Kampus Demo

# Bahasa situs (id_ID = Bahasa Indonesia)
WP_LOCALE=id_ID

# === KONTEN DUMMY (untuk seed.sh) ===
# Jumlah post berita yang akan digenerate
POSTS=500
# Jumlah halaman tambahan yang akan digenerate (di luar halaman utama)
PAGES=20

# === REDIS (opsional, aktifkan dengan --profile redis) ===
REDIS_HOST=redis
REDIS_PORT=6379
